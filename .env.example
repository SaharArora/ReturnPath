# ReturnPath configuration template — no secrets supplied.
# Copy to ~/.config/returnpath/returnpath.env and edit locally.
# The application must expand ~ in paths and let OS env vars override file values.
RP_MODE=local
RP_ALLOW_CONNECTED_WRITES=false
RP_ENABLE_VOICE=false
RP_WEB_HOST=127.0.0.1
RP_WEB_PORT=8000
RP_BASE_URL=http://127.0.0.1:8000
RP_STATE_DIR=~/.local/share/returnpath
RP_OPERATOR_SESSION_SECRET=
RP_OPERATOR_PASSWORD_HASH=

RP_MODEL_PROVIDER=openai
OPENAI_API_KEY=
RP_MODEL=
RP_MODEL_MAX_CALLS_PER_CONTACT=3

RP_GMAIL_CLIENT_PATH=~/.config/returnpath/gmail-client.json
RP_GMAIL_TOKEN_PATH=~/.config/returnpath/gmail-token.json
RP_SUPPORT_EMAIL=
RP_CUSTOMER_EMAIL=
RP_GMAIL_QUERY='subject:"[ReturnPath Demo]" -in:sent'

STRIPE_SECRET_KEY=
RP_STRIPE_ACCOUNT_ID=
RP_MAX_REFUND_CENTS=3000
RP_MAX_AUTOMATIC_REFUNDS_PER_RUN=1
RP_FINANCIAL_RETRY_HORIZON_HOURS=23

SLACK_BOT_TOKEN=
RP_SLACK_CHANNEL_ID=

RP_PROVIDER_TIMEOUT_SECONDS=10
RP_MAX_RETRY_ATTEMPTS=3
RP_WORKER_HEARTBEAT_SECONDS=5
RP_WATCHDOG_POLL_SECONDS=10
RP_WORKER_STALE_SECONDS=20
RP_PROGRESS_STALE_SECONDS=120

# Add Twilio only after the core works; no optional voice secrets needed now.
